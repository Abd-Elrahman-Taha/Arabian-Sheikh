# Arabian Sheikh Luxury Perfume Platform
# Environment Configuration Template

# Backend API Base URL (Contract Base URL: /api)
VITE_API_BASE_URL=http://localhost:5000/api

# Set to 'false' to connect to live backend API, or 'true' to fall back to mock data
VITE_USE_MOCK_API=false

# Default Currency
VITE_DEFAULT_CURRENCY=EUR

# Supported Languages: bg, en, es
VITE_SUPPORTED_LANGUAGES=bg,en,es
