# Arabian Sheikh - Environment Configuration Template
# Copy this file to .env and configure your backend endpoint details

# Real Backend API Base URL (e.g., https://api.arabiansheikh.com/api/v1 or http://localhost:5000/api/v1)
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Enable/Disable Mock Fallback API
# Set to 'false' when connecting to a real live backend API
# Set to 'true' for local offline development without a backend running
VITE_USE_MOCK_API=false

# API Network Request Timeout (in milliseconds)
VITE_API_TIMEOUT=15000
