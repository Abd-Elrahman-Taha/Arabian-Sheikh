# Arabian Sheikh Luxury Perfume Platform
# Environment Configuration Template

# Backend API Base URL (Contract Base URL: /api)
VITE_API_BASE_URL=http://localhost:5000/api

# Set to 'false' to connect to live backend API, or 'true' to fall back to mock data
VITE_USE_MOCK_API=false

# Default Currency
VITE_DEFAULT_CURRENCY=EUR

# Supported Languages: bg, en, es
VITE_SUPPORTED_LANGUAGES=bg,en,es

# Google OAuth 2.0 Client ID (Google Identity Services)
# Configure in Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# Authorized JavaScript Origins: https://arabian-sheikh.vercel.app, http://localhost:5173
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
